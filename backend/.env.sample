PORT=4000
ALLOWED_ORIGINS=http://localhost:5173,
API_URL=http://localhost:4000
APP_URL=http://localhost:5173

## Auth (default: local)
AUTH_MODE=local
JWT_SECRET=change-me-in-production
JWT_EXPIRY=7d
JWT_COOKIE_NAME=hc_token

## Optional: OAuth 2 / OIDC (when AUTH_MODE=oauth2)
# OAUTH2_ISSUER=https://your-idp.com
# OAUTH2_CLIENT_ID=
# OAUTH2_CLIENT_SECRET=
# OAUTH2_REDIRECT_URI=http://localhost:4000/api/auth/callback/oauth2
# OAUTH2_SCOPE=openid profile email
# OAUTH2_CLAIM_EMAIL=email
# OAUTH2_CLAIM_NAME=name
# OAUTH2_CLAIM_ROLES=groups

## Optional: SAML 2.0 (when AUTH_MODE=saml)
# SAML_ENTRY_POINT=https://idp.example.com/saml/sso
# SAML_ISSUER=fountaincms
# SAML_ACS_URL=http://localhost:4000/api/auth/callback/saml
# SAML_IDP_CERT=<IdP certificate PEM>
# SAML_ATTR_EMAIL=email
# SAML_ATTR_NAME=displayName
# SAML_ATTR_ROLES=memberOf

## GraphQL (same auth rules as Content API; POST /api/graphql)
# Apollo Sandbox when NODE_ENV != production

## Content API delivery
# Unauthenticated GET /api/content/collections/:name returns published entries only.
# Authenticated: JWT cookie or Bearer. Machine access: X-Api-Key or Bearer with fcm_* token from POST /api/api-tokens (Super Admin).

## Database Configuration
DB_PORT=5432
POSTGRES_USER=fountain_user
POSTGRES_PASSWORD=fountain_pass
POSTGRES_DB=fountain_db
# When using Docker for Postgres (port 5433 on host): use localhost:5433
# When using local Postgres on default port: use localhost:5432
DATABASE_URL=postgresql://fountain_user:fountain_pass@localhost:5433/fountain_db?schema=public
