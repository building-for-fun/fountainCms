generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName    String   @db.VarChar(255)
  lastName     String   @db.VarChar(255)
  email        String   @db.VarChar(255)
  roleId       String?  @db.Uuid
  role         Role?    @relation(fields: [roleId], references: [id])
  username     String   @unique
  passwordHash String? @db.VarChar(255)
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?  @db.VarChar(255)
  permissions String[]
  users       User[]
}

model ContentTypeDefinition {
  id    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  String   @unique @db.VarChar(255)
  label String?  @db.VarChar(255)
  fields ContentTypeField[]

  @@map("content_type_definitions")
}

model ContentTypeField {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentTypeDefId String   @db.Uuid
  name             String   @db.VarChar(255)
  type             String   @db.VarChar(50)
  required         Boolean  @default(false)
  defaultValue    Json?
  options         Json?
  readonly        Boolean  @default(false)

  contentTypeDef ContentTypeDefinition @relation(fields: [contentTypeDefId], references: [id], onDelete: Cascade)

  @@unique([contentTypeDefId, name])
  @@index([contentTypeDefId])
  @@map("content_type_fields")
}

model ContentItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collection  String    @db.VarChar(255)
  data        Json      @db.Json
  status      String    @default("draft") @db.VarChar(20)
  publishedAt DateTime? @db.Timestamp(6)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([collection])
  @@index([collection, status])
}

model Media {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filename     String   @db.VarChar(512)
  originalName String   @db.VarChar(512)
  mimeType     String   @db.VarChar(255)
  size         Int
  path         String   @db.VarChar(1024)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
  @@map("media")
}

model AuditLog {
  id         String  @id @default(uuid()) @db.Uuid
  action     String
  entity     String
  entityId   String?
  collection String?

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  ip        String?
  userAgent String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([entity])
  @@index([collection])
  @@index([userId])
  @@index([createdAt])
}
